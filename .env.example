# Analytics is fully off unless VITE_UMAMI_WEBSITE_ID is set — no script is
# ever injected without it. See README "Analytics" for what is/isn't tracked.

# Website ID from your Umami instance (cloud.umami.is or self-hosted).
VITE_UMAMI_WEBSITE_ID=

# Only needed if self-hosting Umami instead of using Umami Cloud.
# VITE_UMAMI_SRC=https://your-umami-host/script.js
